# Copy to `.env.local` for local development (never commit real secrets).

# -----------------------------------------------------------------------------
# Required — Supabase (Project Settings → API)
# -----------------------------------------------------------------------------
# Must be the project root only (no /rest/v1). Wrong: https://xxx.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# -----------------------------------------------------------------------------
# Optional — server only (admin email invites via /admin). Never expose to the client.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional — testing-phase workspace bootstrap (server only)
# -----------------------------------------------------------------------------
# When unset/true: if profile has no workspace_id, server uses service role to attach user (see ensure-testing-workspace.ts).
# Set false when DB migrations (handle_new_user) always assign workspace — see supabase/TESTING_PHASE_CHECKLIST.md
# ENABLE_SERVICE_ROLE_WORKSPACE_BOOTSTRAP=true

# -----------------------------------------------------------------------------
# Optional — URLs
# -----------------------------------------------------------------------------
# Used for Supabase invite redirectTo when inviting users from /admin.
# On Vercel, VERCEL_URL is injected automatically as a fallback in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - VERCEL_URL: set automatically on Vercel; referenced in server code for invite redirects.
# - NODE_ENV: set by Next.js (development / production).
# - PORT: set by platforms like Render when running `npm run start`.
